{
  "compilerOptions": {
    "target": "es2021",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "typeRoots": [
      "./src/types",
      "./node_modules/@types"
    ],
    "types": ["node"],
    "resolveJsonModule": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "sourceMap": true,
    "noImplicitAny": true,
    "skipLibCheck": true
  },
 "include": ["src/**/*.ts", "src/**/*.d.ts","axios"]
}